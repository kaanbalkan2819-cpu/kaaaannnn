rules_version = '2';
// World Conquest V114 — Rank Maçı güvenlik kuralları (Firebase Konsolu > Firestore > Kurallar'a yapıştırın).
// Not: PeerJS istemci-otoriter olduğundan bu kurallar HİLEYİ tamamen engellemez; amaç, kullanıcıların
// başkasının verisini silmesini/bozmasını ve puanı tek hamlede uçurmasını sınırlamaktır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function okNick(n) { return n is string && n.size() >= 3 && n.size() <= 14; }

    // ---- Oyuncu profili + liderlik tablosu ----
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && okNick(request.resource.data.nick)
        && request.resource.data.rating == 1000
        && request.resource.data.games == 0;
      allow update: if isMe(uid)
        && okNick(request.resource.data.nick)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating - resource.data.rating <= 60
        && resource.data.rating - request.resource.data.rating <= 60
        && request.resource.data.games - resource.data.games >= 0
        && request.resource.data.games - resource.data.games <= 1
        // puan yalnızca bir maç sayılırken (games +1) değişebilir; yalnızca takma ad güncellemesinde puan sabit kalır
        && (request.resource.data.games == resource.data.games + 1
            || request.resource.data.rating == resource.data.rating);
      allow delete: if false;
    }

    // ---- Eşleşme kuyruğu ----
    match /queue/{uid} {
      allow read: if signedIn();
      allow create, delete: if isMe(uid);
      allow update: if isMe(uid)
        // başka biri yalnızca BEKLEYEN kaydı "eşleşti" yapabilir (status + mid)
        || (signedIn() && resource.data.status == 'waiting'
            && request.resource.data.status == 'matched'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'mid']));
    }

    // ---- Maçlar ----
    match /matches/{mid} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.auth.uid in request.resource.data.players
                    && request.resource.data.players.size() == 2;
      // katılımcılar yalnızca ülke/değişim/sonuç alanlarını değiştirebilir
      allow update: if signedIn() && request.auth.uid in resource.data.players
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hc', 'gc', 'hsw', 'gsw', 'rh', 'rg', 'hok', 'gok']);
      allow delete: if false;
    }
  }
}
