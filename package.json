{
  "name": "world-conquest",
  "version": "1.0.0",
  "private": true,
  "description": "World Conquest mobile app wrapper",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "web:copy": "node -e \"console.log('Game files are stored in ./www')\"",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "release:setup": "node scripts/release_setup.js",
    "release:aab": "node scripts/release_setup.js --build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "cordova-plugin-purchase": "^13.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
